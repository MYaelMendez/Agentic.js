# Gemini API Key (required) — never commit a real value to version control
GEMINI_API_KEY=your_api_key_here

# Allowed origins for the CORS / origin guard (comma-separated)
# Default: http://localhost:5173 (Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173

# Port the Express proxy server listens on
# Default: 3001
PORT=3001
